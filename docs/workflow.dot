// The room review map. render_workflow.py adds the scope, permission and issue flows.
digraph Renovation {
  graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.22", ranksep="0.32", splines=polyline]
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, fontcolor="#173A38",
        color="#73938D", fillcolor="#E8F1ED", penwidth=1.3, margin="0.14,0.1"]
  edge [fontname="Arial", fontsize=10, fontcolor="#284B48", color="#507470", arrowsize=0.7]

  intake [label=<<B>Renovation pack</B><BR/>Brief, sources, budget, shopping<BR/>and limits on change>]
  checklist [label=<<B>CHECKLIST.md</B><BR/>Create at intake. Refresh after each room review.<BR/>Track evidence, acceptance and survey returns.>,fillcolor="#F7F2DE",color="#998451"]
  survey [label=<<B>Survey follow-up</B><BR/>Name the owner and affected work.<BR/>Link the measured return and repeated check.>,fillcolor="#F7F2DE",color="#998451"]
  shell [label=<<B>Existing building · FreeCAD MCP</B><BR/>Build the shell, levels and door heads.<BR/>Set working sizes for unmeasured features.>]
  study [label=<<B>Furniture study · Blender MCP</B><BR/>Try poses on the checked shell.<BR/>Keep the study unrendered.>, fillcolor="#EBEDF6", color="#8791AE"]
  options [label=<<B>Proposed layout · FreeCAD MCP</B><BR/>Reopen the option. Compare occupied<BR/>activities and journeys with the baseline.>]
  decide [label=<<B>Agent and homeowner</B><BR/>Show the labelled plan with the question.<BR/>Record the choice or deciding measurement.>,fillcolor="#F6E7DF",color="#AC7868"]
  style [label=<<B>Homeowner styling choice</B><BR/>Optional colour advice or AI styling study.>,fillcolor="#F6E7DF",color="#AC7868"]
  finish [label=<<B>Furnished camera · Blender MCP</B><BR/>Check door heads in the furnished scene.>,fillcolor="#EBEDF6",color="#8791AE"]
  ai [label=<<B>Final photo · Image editor</B><BR/>Use the reviewed camera and product references.>,fillcolor="#EBEDF6",color="#8791AE"]
  decor [label=<<B>Decorator issue</B><BR/>Check each surface, finish and approval.>,fillcolor="#CCDFCD",color="#708D72"]
  release [label=<<B>Renovation pack · Handover</B><BR/>Check door heads in the issued photo and room pack.<BR/>Update the checklist and deliver the issue.>,fillcolor="#CCDFCD",color="#708D72"]
  node [shape=diamond, style=filled, fillcolor="#F8E9C4", color="#AB854A", fontcolor="#483817", margin="0.07,0.04"]
  fixed [label="Existing CAD fits\nthe sources?"]
  living [label="Whole room works\nand choice resolved?"]
  fidelity [label="Lighting, products and\nwhole-room palette pass?"]

  intake -> shell [label="brief passed"]
  intake -> checklist [label="create and open"]
  checklist -> survey [label="measurement needed"]
  survey -> shell [label="correct measured fabric",style=dashed]
  survey -> options [label="recheck affected design",style=dashed]
  intake -> decor [style=dashed,label="separate finish schedule"]
  shell -> fixed
  fixed -> shell [tailport=w,headport=w,label="correct fabric"]
  fixed -> options [label="pass"]
  fixed -> study [label="pass + study in scope"]
  study -> options [label="return candidate poses"]
  climate [label=<<B>Highly glazed room</B><BR/>Trees and roofs, seated glare,<BR/>summer heat and winter cold.>]
  fixed -> climate [label="exposure drives use"]
  climate -> options [label="return seasonal findings"]
  options -> living
  living -> decide [label="hold"]
  decide -> options [label="revise and retest"]
  living -> finish [label="pass + agreed look"]
  living -> style [label="look undecided"]
  style -> finish [label="items sourced, fit checked"]
  finish -> fidelity
  fidelity -> finish [tailport=e,headport=e,label="fix scene or item"]
  fidelity -> style [label="ask about open choice"]
  fidelity -> ai [label="visual checks pass"]
  ai -> ai [label="retry from camera"]
  ai -> release [label="briefed views, operation and colours pass"]

  assembled [label=<<B>Whole-house photo issue</B><BR/>Check visible rooms and window coverings<BR/>from inside and outside against current designs.>,shape=box]
  release -> assembled [label="all room packs ready"]
  assembled -> finish [label="correct incomplete sightline",style=dashed]
  {rank=same; finish; style}
  {rank=same; study; fixed}
  {rank=same; living; decide}
}
