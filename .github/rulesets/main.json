{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "House workflow tests",
            "integration_id": 15368
          },
          {
            "context": "Private files and Gitleaks",
            "integration_id": 15368
          },
          {
            "context": "Offline pack readers (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Offline pack readers (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Dependency audit (toolkit)",
            "integration_id": 15368
          },
          {
            "context": "Dependency audit (solver)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
